{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "acme",
  "homepage": "https://acme.com",
  "items": [
    {
      "name": "announcement",
      "type": "registry:ui",
      "title": "Announcement",
      "description": "A pill that links to what's new.",
      "dependencies": ["cn", "@base-ui/react"],
      "files": [
        {
          "path": "ui/announcement.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "rating",
      "type": "registry:ui",
      "title": "Rating",
      "description": "A star rating built on a radio group.",
      "dependencies": ["cn", "@base-ui/react"],
      "registryDependencies": ["@acme/use-controllable-state"],
      "files": [
        {
          "path": "ui/rating.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "copy-button",
      "type": "registry:ui",
      "title": "Copy Button",
      "description": "A button that copies a value to the clipboard.",
      "dependencies": ["cn"],
      "registryDependencies": ["button", "@acme/use-copy-to-clipboard"],
      "files": [
        {
          "path": "ui/copy-button.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "timeline",
      "type": "registry:ui",
      "title": "Timeline",
      "description": "A vertical list of events.",
      "dependencies": ["cn"],
      "files": [
        {
          "path": "ui/timeline.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "use-controllable-state",
      "type": "registry:hook",
      "title": "useControllableState",
      "description": "State a parent can control, or leave to the component.",
      "files": [
        {
          "path": "hooks/use-controllable-state.ts",
          "type": "registry:hook"
        }
      ]
    },
    {
      "name": "use-copy-to-clipboard",
      "type": "registry:hook",
      "title": "useCopyToClipboard",
      "description": "Copies text to the clipboard and tracks the copied state.",
      "files": [
        {
          "path": "hooks/use-copy-to-clipboard.ts",
          "type": "registry:hook"
        }
      ]
    },
    {
      "name": "format",
      "type": "registry:lib",
      "title": "format",
      "description": "Formats dates, byte sizes and large numbers.",
      "files": [
        {
          "path": "lib/format.ts",
          "type": "registry:lib"
        }
      ]
    }
  ]
}
