{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "eslint.enable": false,
  "biome.enabled": false,
  "oxc.enable": true,
  "tailwindCSS.validate": true,
  "tailwindCSS.lint.cssConflict": "ignore",
  "tailwindCSS.lint.suggestCanonicalClasses": "ignore",
  "tailwindCSS.experimental.configFile": {
    "apps/web/src/globals.css": ["apps/web/**"],
    "packages/ui/src/styles/globals.css": ["packages/ui/**"]
  },
  "tailwindCSS.classFunctions": ["cn", "cva"],
  "tailwindCSS.files.exclude": [
    "**/.git/**",
    "**/node_modules/**",
    "**/.hg/**",
    "**/.svn/**",
    "**/registry/styles/style-{vega,nova,maia,lyra,mira,luma,sera,rhea}.css",
    "**/registry/styles/shadcn/**"
  ],
  "css.lint.unknownAtRules": "ignore",
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.next/**": true,
    "**/.turbo/**": true,
    "**/dist/**": true,
    "**/build/**": true
  },
  "search.exclude": {
    "**/.git": true,
    "**/.next": true,
    "**/.turbo": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "pnpm-lock.yaml": true
  },
  "files.exclude": {
    "**/.git": false,
    "**/.turbo": true
  }
}
